# ---------------- límite de tráfico por día ----------------
# Cuenta lo que mueven las conexiones que abren los propios usuarios (túneles SSH), subida y
# bajada, solo IPv4. Cada conexión nueva se marca con el uid del usuario (connmark, bits altos
# 0xffff0000) y reglas iptables por usuario cuentan los bytes. Los contadores se acumulan por día.
gb() { awk -v b="${1:-0}" 'BEGIN{printf "%.2f", b/1073741824}'; }   # bytes -> GB (1 GB = 1024^3)

limite_hoy_bytes() {
  local g=$LIMITE_SEMANA_GB
  (( $(date +%u) >= 6 )) && g=$LIMITE_FINDE_GB
  awk -v g="${g:-0}" 'BEGIN{printf "%.0f", g*1073741824}'
}

# Crea las cadenas y, por cada usuario, las reglas que faltan. Nunca borra reglas
# (así se conservan los contadores). Usa -w para esperar el candado de iptables.
asegurar_contadores() {
  local ipt="iptables -w" m=0xffff0000 uid mark t
  local -A hm ho hi
  $ipt -N VIGIA_MARK 2>/dev/null
  $ipt -N VIGIA_ACCT_O 2>/dev/null
  $ipt -N VIGIA_ACCT_I 2>/dev/null

  # Enganches arriba de todo, para que ningún ACCEPT anterior los saltee
  $ipt -C OUTPUT -m connmark ! --mark "0x0/$m" -j VIGIA_ACCT_O 2>/dev/null || \
    $ipt -I OUTPUT 1 -m connmark ! --mark "0x0/$m" -j VIGIA_ACCT_O
  $ipt -C OUTPUT -m conntrack --ctstate NEW -m owner --uid-owner "$UID_MIN-$UID_MAX" -j VIGIA_MARK 2>/dev/null || \
    $ipt -I OUTPUT 1 -m conntrack --ctstate NEW -m owner --uid-owner "$UID_MIN-$UID_MAX" -j VIGIA_MARK
  $ipt -C INPUT -m connmark ! --mark "0x0/$m" -j VIGIA_ACCT_I 2>/dev/null || \
    $ipt -I INPUT 1 -m connmark ! --mark "0x0/$m" -j VIGIA_ACCT_I

  while read -r t; do hm[$t]=1; done < <($ipt -S VIGIA_MARK 2>/dev/null | grep -o 'vg:[0-9]*')
  while read -r t; do ho[$t]=1; done < <($ipt -S VIGIA_ACCT_O 2>/dev/null | grep -o 'vg:[0-9]*')
  while read -r t; do hi[$t]=1; done < <($ipt -S VIGIA_ACCT_I 2>/dev/null | grep -o 'vg:[0-9]*')
  while IFS=: read -r _ _ uid _; do
    [[ $uid =~ ^[0-9]+$ ]] && (( uid >= UID_MIN && uid <= UID_MAX )) || continue
    mark=$(printf '0x%x' $(( uid << 16 )))
    [[ -n ${hm[vg:$uid]} ]] || $ipt -A VIGIA_MARK -m owner --uid-owner "$uid" -m comment --comment "vg:$uid" -j CONNMARK --set-xmark "$mark/$m"
    [[ -n ${ho[vg:$uid]} ]] || $ipt -A VIGIA_ACCT_O -m connmark --mark "$mark/$m" -m comment --comment "vg:$uid"
    [[ -n ${hi[vg:$uid]} ]] || $ipt -A VIGIA_ACCT_I -m connmark --mark "$mark/$m" -m comment --comment "vg:$uid"
  done < <(getent passwd)
}

# Bytes acumulados por usuario en los contadores de iptables (subida + bajada): uid|bytes
contadores() {
  { iptables -w -nvxL VIGIA_ACCT_O 2>/dev/null; iptables -w -nvxL VIGIA_ACCT_I 2>/dev/null; } | awk '
    match($0,/vg:[0-9]+/) { u=substr($0,RSTART+3,RLENGTH-3); t[u]+=$2 }
    END{ for(u in t) printf "%s|%.0f\n", u, t[u] }'
}

# Pasa lo contado desde la última vez al total del día. Si el contador bajó (reinicio del
# servidor o de las reglas) cuenta todo el valor nuevo. Cambia el día -> el total vuelve a 0.
actualizar_trafico() {
  local hoy; hoy=$(date +%F)
  (
    flock -x 9
    contadores > "$TRAFICO.cnt"
    awk -F'|' -v hoy="$hoy" '
      FILENAME==ARGV[1] { cnt[$1]=$2+0; next }
      {
        u=$1; dia=$2; acum=$3+0; ult=$4+0
        if (u in cnt) {
          c=cnt[u]; delta=(c>=ult)?c-ult:c
          if (dia!=hoy) { acum=0; dia=hoy }
          acum+=delta; ult=c; visto[u]=1
        }
        printf "%s|%s|%.0f|%.0f\n", u, dia, acum, ult
      }
      END { for (u in cnt) if (!(u in visto)) printf "%s|%s|%.0f|%.0f\n", u, hoy, 0, cnt[u] }
    ' "$TRAFICO.cnt" "$TRAFICO" > "$TRAFICO.tmp" && mv "$TRAFICO.tmp" "$TRAFICO"
    rm -f "$TRAFICO.cnt"
  ) 9> "$CONF_DIR/trafico.lock"
}

reiniciar_trafico() {  # $1 usuario: pone en 0 lo usado hoy
  local uid; uid=$(id -u "$1" 2>/dev/null) || return
  (
    flock -x 9
    awk -F'|' -v OFS='|' -v u="$uid" '$1==u{$3=0} {print}' "$TRAFICO" > "$TRAFICO.tmp" && mv "$TRAFICO.tmp" "$TRAFICO"
  ) 9> "$CONF_DIR/trafico.lock"
}

# Bloquea a quien llegó al límite de hoy (no depende de AUTO_BLOQUEO ni toca a los EXENTOS)
control_trafico() {
  local lim hoy fecha uid dia acum ult u g
  lim=$(limite_hoy_bytes)
  (( lim > 0 )) || return
  hoy=$(date +%F); fecha=$(date '+%F %H:%M')
  while IFS='|' read -r uid dia acum ult; do
    [[ -z $uid || $dia != "$hoy" ]] && continue
    (( acum >= lim )) || continue
    u=$(getent passwd "$uid" | cut -d: -f1); [[ -z $u ]] && continue
    [[ ,$EXENTOS, == *,$u,* ]] && continue
    bloqueado "$u" && continue
    g="$(gb "$acum") GB de $(gb "$lim") GB"
    echo "$fecha | $u | LIMITE DIARIO DE TRAFICO superado: $g" >> "$ALERTAS"
    bloquear "$u" "LIMITE diario ($g)" && echo "$fecha | $u | BLOQUEADO POR LIMITE DE TRAFICO" >> "$ALERTAS"
  done < "$TRAFICO"
}

modo_trafico() {
  asegurar_contadores
  desbloqueo_automatico
  actualizar_trafico
  control_trafico
}

op_trafico() {
  titulo "TRAFICO DE HOY POR USUARIO"
  asegurar_contadores; actualizar_trafico
  local hoy lim uid dia acum ult col pct u hay=0
  hoy=$(date +%F); lim=$(limite_hoy_bytes)
  printf "${W}%-16s %12s %9s${N}\n" USUARIO "USADO (GB)" "% LIMITE"
  while IFS='|' read -r uid dia acum ult; do
    (( acum > 0 )) || continue
    hay=1; u=$(nombre "$uid"); col=$G; pct="-"
    if (( lim > 0 )); then
      pct=$(( acum * 100 / lim ))
      (( pct >= 70 )) && col=$Y
      (( pct >= 100 )) && col=$R
      pct="$pct%"
    fi
    printf "${col}%-16s %12s %9s${N}\n" "$u" "$(gb "$acum")" "$pct"
  done < <(awk -F'|' -v h="$hoy" '$2==h' "$TRAFICO" | sort -t'|' -k3,3nr | head -30)
  (( hay )) || echo -e "${G}Todavía no hay tráfico registrado hoy.${N}"
  echo
  if (( lim > 0 )); then
    echo -e "Límite de hoy: ${Y}$(gb "$lim") GB${N} por usuario ($( (( $(date +%u) >= 6 )) && echo "fin de semana" || echo "entre semana"))"
  else
    echo -e "Límite de hoy: ${R}sin límite${N} (se configura en la opción 13)"
  fi
  echo -e "Cuenta solo el tráfico de las conexiones que abren los usuarios (IPv4)."
  ofrecer_bloqueo
}

# ---------------- modo automático (cron) ----------------
# Registra una alerta (máx. 1 por usuario y tipo cada hora) y bloquea si corresponde
alertar() {  # $1 usuario  $2 tipo  $3 motivo
  local ahora ultimo fecha
  ahora=$(date +%s); fecha=$(date '+%F %H:%M')
  ultimo=$(awk -F'|' -v u="$1" -v t="$2" '$1==u && $2==t {print $3}' "$AVISOS" | tail -1)
  (( ahora - ${ultimo:-0} < 3600 )) && return
  awk -F'|' -v u="$1" -v t="$2" '!($1==u && $2==t)' "$AVISOS" > "$AVISOS.tmp" && mv "$AVISOS.tmp" "$AVISOS"
  echo "$1|$2|$ahora" >> "$AVISOS"
  echo "$fecha | $1 | $3" >> "$ALERTAS"
  if [[ $AUTO_BLOQUEO == 1 ]] && bloquear "$1" "AUTO $3"; then
    echo "$fecha | $1 | BLOQUEADO AUTOMÁTICAMENTE" >> "$ALERTAS"
  fi
}

# Desbloqueo automático:
#  - motivo "AUTO ...": pasadas HORAS_DESBLOQUEO horas (0 = nunca)
#  - motivo "LIMITE ...": al empezar el día siguiente
# Los bloqueos manuales no se tocan.
desbloqueo_automatico() {
  local limite=$(( ${HORAS_DESBLOQUEO:-0} * 3600 )) ahora hoy u f m t item txt lista=()
  ahora=$(date +%s); hoy=$(date +%F)
  while IFS='|' read -r u f m; do
    [[ -z $u ]] && continue
    if [[ $m == LIMITE* ]]; then
      [[ ${f%% *} != "$hoy" ]] && lista+=("$u|nuevo día, cuota renovada")
    elif [[ $m == AUTO* ]] && (( limite > 0 )); then
      t=$(date -d "$f" +%s 2>/dev/null) || continue
      (( ahora - t >= limite )) && lista+=("$u|pasaron ${HORAS_DESBLOQUEO}h")
    fi
  done < "$BLOQ"
  for item in "${lista[@]}"; do
    IFS='|' read -r u txt <<< "$item"
    desbloquear "$u"
    echo "$(date '+%F %H:%M') | $u | DESBLOQUEADO AUTOMÁTICAMENTE ($txt)" >> "$ALERTAS"
  done
}

modo_auto() {
  asegurar_reglas
  desbloqueo_automatico
  local u uid t nd np pl c d p n

  # 1) Escaneo: muchas IPs o puertos raros en la ventana
  while read -r uid t nd np pl; do
    [[ -z $uid ]] && continue
    (( nd >= MAX_DESTINOS || np >= MAX_PUERTOS )) || continue
    u=$(nombre "$uid"); bloqueado "$u" && continue
    alertar "$u" escaneo "escaneo: $nd IPs / $np puertos en ${VENTANA}min (${pl:0:40})"
  done < <(resumen_log "$VENTANA")

  # 2) Escaneo en vivo: muchas conexiones sin respuesta a la vez
  while read -r uid c d p; do
    [[ -z $uid ]] && continue
    (( c >= MAX_SYN )) || continue
    u=$(nombre "$uid"); bloqueado "$u" && continue
    alertar "$u" synsent "$c conexiones sin respuesta a la vez ($d IPs / $p puertos)"
  done < <(por_uid syn-sent)

  # 3) Checker de correos: muchos servidores de correo distintos en 1 hora
  while read -r uid n; do
    [[ -z $uid ]] && continue
    (( n >= MAX_CORREO )) || continue
    u=$(nombre "$uid"); bloqueado "$u" && continue
    alertar "$u" correo "posible checker de correos: $n servidores de correo distintos en 1 hora"
  done < <(eventos 60 | awk -v re="^($PUERTOS_CORREO)$" '$3 ~ re && !(($1,$2) in s) {s[$1,$2]=1; n[$1]++}
           END{for(u in n) print u, n[u]}')
}

# ---------------- menú ----------------
op() { printf "${G}-%02d-${Y}%-26s${G}-%02d-${Y}%s${N}\n" "$1" "$2" "$3" "$4"; }

menu() {
  local o em ea nb
  while true; do
    # shellcheck source=/dev/null
    source "$CONF"
    [[ -f $CRON ]] && em="${G}ON${N}" || em="${R}OFF${N}"
    [[ $AUTO_BLOQUEO == 1 ]] && ea="${G}SI${N}" || ea="${R}NO${N}"
    nb=$(grep -c . "$BLOQ")
    clear; linea
    echo -e "${W}            🛡  VIGIA - CONTROL DE ABUSO${N}"
    echo -e "   Monitor: $em   Autobloqueo: $ea   Bloqueados: ${Y}$nb${N}"
    linea
    op 1 "CONEXIONES X USUARIO"  8 "LISTA BLOQUEADOS"
    op 2 "ESCANEO EN VIVO"       9 "BLOQUEAR PUERTO"
    op 3 "ANALIZAR REGISTRO"    10 "DESBLOQUEAR PUERTO"
    op 4 "DETALLE DE USUARIO"   11 "VER ALERTAS"
    op 5 "PUERTOS MAS INTENTADOS" 12 "MONITOR AUTOMATICO"
    op 6 "BLOQUEAR USUARIO"     13 "CONFIGURAR LIMITES"
    op 7 "DESBLOQUEAR USUARIO"  14 "REPARAR REGLAS"
    op 15 "RASTREAR DESTINOS"   16 "TRAFICO POR USUARIO"
    echo -e "${R}-00-SALIR ❌${N}"
    linea
    echo -ne "${W}Opción: ${N}"; read -r o
    [[ $o =~ ^[0-9]+$ ]] && o=$((10#$o))
    case $o in
      1) op_conexiones ;;       2) op_escaneo_vivo ;;
      3) op_registro ;;         4) op_detalle ;;
      5) op_puertos ;;          6) op_bloquear ;;
      7) op_desbloquear ;;      8) op_lista ;;
      9) op_bloquear_puerto ;; 10) op_desbloquear_puerto ;;
     11) op_alertas ;;         12) op_monitor ;;
     13) op_config ;;          14) op_reparar ;;
     15) op_rastrear ;;       16) op_trafico ;;
      0) clear; exit 0 ;;
    esac
  done
}

# Autoinstalación: si se ejecuta desde otro lugar, se copia a /usr/local/bin/vigia
DESTINO=/usr/local/bin/vigia
if [[ $1 != --auto && $1 != --trafico && $(readlink -f "$0") != "$DESTINO" ]]; then
  cp -f "$0" "$DESTINO" && chmod +x "$DESTINO"
  echo -e "${G}✔ VIGIA instalado en $DESTINO. Desde ahora abrilo con: vigia${N}"; sleep 2
fi

# Cron de una versión anterior (sin control de tráfico): actualizarlo
[[ -f $CRON ]] && ! grep -q -- '--trafico' "$CRON" && escribir_cron

case "$1" in
  --auto|--trafico)
    # una sola pasada a la vez (si hay otra corriendo, espera hasta 50 s y se rinde)
    exec 8>"$CONF_DIR/vigia.lock"; flock -w 50 8 || exit 0
    if [[ $1 == --auto ]]; then modo_auto; else modo_trafico; fi ;;
  *) asegurar_reglas; guardar_reglas; menu ;;
esac
